    "科技馆": {"categories": ["amenity=exhibition_centre", "tourism=museum"]},
    "科研院所": {"categories": ["amenity=research_institute", "office=research"], "note": "科研院所不是高校，问高校时不要合并进来"},
    "银行": {"categories": ["amenity=bank"]},
    "取款机": {"categories": ["amenity=atm"]},
