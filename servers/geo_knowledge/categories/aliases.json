    "酒店": {"categories": ["tourism=hotel", "tourism=guest_house", "tourism=hostel", "tourism=motel"], "note": "国内「酒店」这个词同时指餐馆与住宿，除非语境明确是住宿，否则应追问"},
    "宾馆": {"categories": ["tourism=hotel", "tourism=guest_house"]},
