{
  "id": "poi-category-aliases",
  "name": "POI 类别的中文别名表",
  "version": "1.0",
  "effective_from": "2026-09-12",
  "applies_to": ["query_nearby", "summarize_poi", "任何按类别筛选 POI 的查询"],

  "how_to_use": [
    "调用 query_nearby / summarize_poi 时，categories 可以直接写这里的中文说法（如「高校」），也可以写 OSM 值（university）或 key=value（amenity=university）。",
    "一个中文说法可能对应多个 OSM 值：『高校』在 OSM 里拆成 amenity=university 与 amenity=college 两个值，只查其中一个会漏掉一半。",
    "别名由服务端展开，模型不需要自己猜 OSM 标签；对不上号的类别会直接报错并给出近似建议，不会静默返回 0 条。",
    "这里没有的说法不等于库里没有：全库 469 个 (category_key, category_value) 组合的完整清单见 compute://categories。"
  ],

  "aliases": {
    "医院": {"categories": ["amenity=hospital"]},
    "诊所": {"categories": ["amenity=clinic"]},
    "卫生院": {"categories": ["amenity=clinic", "amenity=doctors"]},
    "牙科": {"categories": ["amenity=dentist"]},
    "药店": {"categories": ["amenity=pharmacy"], "note": "shop=chemist 是英式叫法，北京数据里与 pharmacy 高度重叠，默认不合并以免重复计数"},
    "宠物医院": {"categories": ["amenity=veterinary"]},
    "高校": {"categories": ["amenity=university", "amenity=college"], "note": "OSM 把高校拆成 university 与 college 两个值，只查一个会漏；另有个别高校的行政机构挂在 office=university（全库 2 条）"},
    "大学": {"categories": ["amenity=university", "amenity=college"]},
    "学校": {"categories": ["amenity=school"], "note": "OSM 的 school 不区分中小学与学段，也不含高校与幼儿园"},
    "中学": {"categories": ["amenity=school"], "note": "OSM 无中学/小学之分，只能由 school 覆盖，需在结论里说明这一局限"},
    "小学": {"categories": ["amenity=school"], "note": "OSM 无中学/小学之分，只能由 school 覆盖，需在结论里说明这一局限"},
    "幼儿园": {"categories": ["amenity=kindergarten"]},
    "托儿所": {"categories": ["amenity=kindergarten", "amenity=childcare"]},
    "图书馆": {"categories": ["amenity=library"]},
