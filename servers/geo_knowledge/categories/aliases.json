    "宗教场所": {"categories": ["amenity=place_of_worship"], "note": "含寺庙、教堂、清真寺等，宗教细分要看 other_tags 里的 religion 标签"},
    "寺庙": {"categories": ["amenity=place_of_worship", "historic=temple"]},
    "教堂": {"categories": ["amenity=place_of_worship"]},
    "电影院": {"categories": ["amenity=cinema"]},
    "剧院": {"categories": ["amenity=theatre"]},
    "文化馆": {"categories": ["amenity=arts_centre", "amenity=community_centre"]},
    "社区中心": {"categories": ["amenity=community_centre"]},
    "纪念馆": {"categories": ["historic=memorial"]},
    "古迹": {"categories": ["historic=monument", "historic=archaeological_site", "historic=castle", "historic=ruins"]},
    "历史建筑": {"categories": ["historic=building", "historic=heritage_building"]},
    "公交站": {"categories": ["amenity=bus_station"], "note": "只有 amenity=bus_station（枢纽站）；路边的 highway=bus_stop 在 anchor 层，不参与半径查询"},
    "公园长椅": {"categories": ["amenity=bench"]},
    "饮水点": {"categories": ["amenity=drinking_water", "amenity=water_point"]},
    "避难场所": {"categories": ["amenity=shelter"]}
  },

  "not_available": {
    "地铁站": "地铁站在 anchor 层（railway=station）只用于定位，不参与半径设施检索：query_nearby 只覆盖 poi_point 与 poi_area 两层，railway 标签不在其中",
    "地铁口": "同上：地铁相关对象只在 anchor 层，不在 poi_point / poi_area",
    "火车站": "火车站只在 anchor 层（railway=station），POI 两层里没有 railway 标签的设施",
    "公交线路": "库中没有公交线路数据，只有公交站与地铁站这两类点位",
    "人口": "库中只有行政边界面积与 POI，没有人口、经济等统计数据"
  },

  "known_limitations": [
    "别名是人工维护的映射，只覆盖常见问法；库里的 469 个类别组合不需要别名也能直接查（compute://categories）。",
    "中文别名与 OSM 值的对应关系按中国大陆语境整理，不代表 OSM 官方分类。",
    "同一个 OSM 值可能出现在不同 key 下（如 university 在 amenity 与 office 下），别名要么显式写 key=value，要么用裸值表示不限 key。"
  ]
}
