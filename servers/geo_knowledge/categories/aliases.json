    "饭馆": {"categories": ["amenity=restaurant"]},
    "快餐": {"categories": ["amenity=fast_food"]},
    "咖啡馆": {"categories": ["amenity=cafe"]},
    "酒吧": {"categories": ["amenity=bar", "amenity=pub"]},
    "冷饮店": {"categories": ["amenity=ice_cream"]},
