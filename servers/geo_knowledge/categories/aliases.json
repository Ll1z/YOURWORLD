    "邮局": {"categories": ["amenity=post_office"]},
    "快递柜": {"categories": ["amenity=parcel_locker"]},
    "便利店": {"categories": ["shop=convenience"]},
    "超市": {"categories": ["shop=supermarket"]},
    "商场": {"categories": ["shop=mall", "shop=department_store"]},
    "菜市场": {"categories": ["amenity=marketplace"]},
    "菜店": {"categories": ["shop=greengrocer"]},
    "面包房": {"categories": ["shop=bakery"]},
    "理发店": {"categories": ["shop=hairdresser"]},
    "洗衣店": {"categories": ["shop=laundry", "shop=dry_cleaning"]},
    "加油站": {"categories": ["amenity=fuel"]},
    "充电桩": {"categories": ["amenity=charging_station"]},
    "停车场": {"categories": ["amenity=parking"], "note": "含停车区与停车入口等细分值（parking_space / parking_entrance），问「停车场」时通常只看 amenity=parking 即可"},
