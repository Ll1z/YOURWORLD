# 复制为 .env 后填入真实值；.env 不入库
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TIANDITU_KEY=your_tianditu_key_here

# 观测出口（可选）：留空只写本地 spans.jsonl；填了就同时推到 OTLP 后端。
# Langfuse v3：ENDPOINT=https://cloud.langfuse.com/api/public/otel
#              HEADERS=Authorization=Basic <base64(public_key:secret_key)>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
