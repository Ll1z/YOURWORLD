# 虚拟环境与工具缓存
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# 敏感信息
.env

# 沙箱运行产物
sandbox/run_*/

# 本地临时调试产物（仓库根目录下划线前缀，不入库）
/_*

# 数据与索引（体积大、可重新下载，不入库）
data/raw/
data/processed/*
*.duckdb
*.duckdb.wal
*.gpkg

# 例外：充当系统原子单元的地基数据入库
!data/processed/districts_wgs84.geojson
!data/processed/districts_wgs84.gpkg
